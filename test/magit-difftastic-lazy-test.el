(ert-deftest magit-difftastic-lazy/refresh-prunes-both-stage-subscriptions ()
  (dst-lazy-test--fixture
    (let* ((old (dst-lazy-test--tree))
           (render (magit-difftastic--lazy-file-callback old))
           (async-request (symbol-function 'magit-difftastic--async-request))
           new removed)
      (funcall render raw nil)
      (let ((validation (magit-difftastic--lazy-file-validation-callback old)))
        (cl-letf (((symbol-function 'magit-difftastic--async-unsubscribe)
                   (lambda (owner callback) (push (list owner callback) removed)))
                  ((symbol-function 'magit-difftastic--async-request)
                   (lambda (&rest args)
                     (should magit-difftastic--refreshing)
                     (apply async-request args))))
          (should (eq
                   (magit-difftastic--refresh-advice
                    (lambda (value)
                      (let ((inhibit-read-only t)) (erase-buffer))
                      (setq new (dst-lazy-test--tree))
                      value)
                    'refreshed)
                   'refreshed)))
        (should (equal magit-difftastic--lazy-requests (list new)))
        (should (= (length removed) 2))
        (should (member (list (current-buffer) render) removed))
        (should (member (list (current-buffer) validation) removed))
        (let ((text (buffer-string)) (count (length requests)))
          (funcall render raw nil)
          (funcall validation metadata nil)
          (should (= (length requests) count))
          (should (equal text (buffer-string)))
          (should (eq (magit-difftastic--lazy-file-state new) 'pending)))
        (should (zerop (hash-table-count magit-difftastic--cache)))))))

(ert-deftest magit-difftastic-lazy/prune-retains-shared-current-jobs ()
  (let ((subscribe (symbol-function 'magit-difftastic--async-request)))
    (dst-lazy-test--fixture
      (dst-async-test--mocked
        (cl-letf (((symbol-function 'magit-difftastic--async-request) subscribe))
          (let* ((old (dst-lazy-test--tree))
                 (render-job (magit-difftastic--lazy-file-job old))
                 validation-job new)
            (funcall (magit-difftastic--lazy-file-callback old) raw nil)
            (setq validation-job (magit-difftastic--lazy-file-job old))
            (should-not (eq render-job validation-job))
            (magit-difftastic--refresh-advice
             (lambda ()
               (let ((inhibit-read-only t)) (erase-buffer))
               (setq new (dst-lazy-test--tree))
               (should (eq render-job (magit-difftastic--lazy-file-job new)))
               (funcall (magit-difftastic--lazy-file-callback new) raw nil)
               (should (eq validation-job (magit-difftastic--lazy-file-job new)))))
            (should (equal magit-difftastic--lazy-requests (list new)))
            (should (= (hash-table-count magit-difftastic--async-jobs) 2))
            (cl-mapc
             (lambda (job callback)
               (should (magit-difftastic--async-current-p job))
               (should (eq (magit-difftastic--async-job-state job) 'queued))
               (should (equal (magit-difftastic--async-job-subscribers job)
                              (list (list (current-buffer) callback nil)))))
             (list render-job validation-job)
             (list (magit-difftastic--lazy-file-callback new)
                   (magit-difftastic--lazy-file-validation-callback new)))
            (magit-difftastic--lazy-prune)
            (should (= (hash-table-count magit-difftastic--async-jobs) 2))
            (should-not launches)))))))

(provide 'magit-difftastic-lazy-test)
