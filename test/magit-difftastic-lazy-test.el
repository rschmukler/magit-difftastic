  (dst-lazy-test--isolated
    (dst-test--with-repo `(("sample.txt" . ,dst-test--old))
        `(("sample.txt" . ,dst-test--new))
      (with-temp-buffer
        (magit-status-mode)
        (let ((magit-difftastic-lazy nil)
              (inhibit-read-only t)
              (prewarm (symbol-function 'magit-difftastic--prewarm))
              calls)
          (cl-letf (((symbol-function 'magit-difftastic--prewarm)
                     (lambda (&rest args) (push args calls) (apply prewarm args)))
                    ((symbol-function 'magit-difftastic--async-request)
                     (lambda (&rest _) (ert-fail "Unexpected lazy request"))))
            (magit-insert-section (root)
              (magit-difftastic--insert-file-sections
               '("sample.txt") (magit-difftastic--context-unstaged))))
          (should (= (length calls) 1))
          (let ((section (car (oref magit-root-section children))))
            (should (oref section hidden))
