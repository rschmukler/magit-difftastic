(ert-deftest magit-difftastic-lazy/real-async-expanded-file ()
  (skip-unless dst-test--have-tools)
  (dst-lazy-test--isolated
    (dst-test--with-repo `(("sample.txt" . ,dst-test--old))
        `(("sample.txt" . ,dst-test--new))
      (with-temp-buffer
        (magit-diff-mode)
        (let* ((request (dst-lazy-test--tree))
               (section (magit-difftastic--lazy-file-section request))
               (job (magit-difftastic--lazy-file-job request)))
          (unwind-protect
              (progn
                (should job)
                (should-not (oref section hidden))
                (dst-async-test--wait
                 (lambda () (memq (magit-difftastic--lazy-file-state request)
                                  '(rendered failed stale))))
                (should (eq (magit-difftastic--lazy-file-state request) 'rendered))
                (should (string-match-p "BRAVO-changed" (dst-lazy-test--body section)))
                (should (oref section children))
                (should-not (magit-difftastic--async-job-buffer job))
                (should (zerop magit-difftastic--async-active))
                (should (zerop (hash-table-count magit-difftastic--async-jobs)))
