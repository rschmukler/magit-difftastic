           (section (magit-difftastic--lazy-file-section request))
           (magit-section-initial-visibility-alist '((magit-difftastic-hunk . hide))))
      (magit-section-show section)
      (dst-lazy-test--deliver)
      (should (eq (magit-difftastic--lazy-file-state request) 'rendered))
      (should (oref section children))
      (dolist (chunk (oref section children))
        (should (oref chunk hidden))
        (should (< (oref chunk content) (oref chunk end)))
        (should-not (invisible-p (oref chunk start)))
        (let ((position (marker-position (oref chunk content))))
          (while (< position (oref chunk end))
            (should (invisible-p position))
            (cl-incf position)))))))

