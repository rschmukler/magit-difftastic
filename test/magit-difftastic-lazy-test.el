;;; magit-difftastic-lazy-test.el --- Lazy section tests -*- lexical-binding: t; -*-

;;; Commentary:
;; Real Magit section trees with deferred UI delivery and isolated processes.

;;; Code:

(eval-and-compile
  (let ((load-path (cons (expand-file-name
                         "test" (file-name-directory
                                 (locate-library "magit-difftastic")))
                        load-path)))
    (require 'magit-difftastic-test)
    (require 'magit-difftastic-async-test)))

(defconst dst-lazy-test--render-raw
  (symbol-function 'magit-difftastic--render-raw)
  "Synchronous fixture renderer, independent of UI test stubs.")

(defmacro dst-lazy-test--isolated (&rest body)
  "Evaluate BODY with isolated caches, scheduler, and show advice."
  (declare (indent 0) (debug t))
  `(dst-async-test--isolated
     (let ((magit-difftastic-lazy t)
           (magit-difftastic-cache t)
           (magit-difftastic--cache (make-hash-table :test #'equal))
           (magit-difftastic--syntax-cache (make-hash-table :test #'equal))
           (magit-difftastic--render-cache nil)
           (magit-difftastic-default-rendering 'difftastic)
           (magit-difftastic-display "side-by-side-show-both")
           (magit-difftastic-width 120)
           (magit-difftastic-align-columns nil)
           (magit-difftastic-syntax-highlight nil)
           (had-advice (advice-member-p #'magit-difftastic--lazy-show
                                        'magit-section-show)))
       (unwind-protect
           (progn
             (advice-add 'magit-section-show :after #'magit-difftastic--lazy-show)
             ,@body)
         (unless had-advice
           (advice-remove 'magit-section-show #'magit-difftastic--lazy-show))))))

(defmacro dst-lazy-test--fixture (&rest body)
  "Evaluate BODY with a changed repository and deferred render callbacks."
  (declare (indent 0) (debug t))
  `(progn
     (skip-unless dst-test--have-tools)
     (dst-lazy-test--isolated
       (dst-test--with-repo
           `(("sample.txt" . ,dst-test--old))
           `(("sample.txt" . ,dst-test--new))
         (let ((raw (funcall dst-lazy-test--render-raw
                             "sample.txt" magit-difftastic--diff-base 120))
               (metadata
                (with-temp-buffer
                  (should (zerop
                           (apply #'process-file "git" nil t nil
                                  (append (magit-difftastic--raw-args
                                           magit-difftastic--diff-base)
                                          '("--" "sample.txt")))))
                  (buffer-string)))
               requests promotions)
           (should (gethash "sample.txt" (magit-difftastic--parse-raw-info metadata)))
           (should (string-match-p "BRAVO-changed" raw))
           (cl-letf (((symbol-function 'magit-difftastic--async-request)
                      (lambda (&rest args) (push args requests) nil))
                     ((symbol-function 'magit-difftastic--async-promote)
                      (lambda (job) (push job promotions)))
                     ((symbol-function 'magit-difftastic--render-raw)
                      (lambda (&rest _) (ert-fail "Unexpected synchronous render")))
                     ((symbol-function 'magit-difftastic--prewarm)
                      (lambda (&rest _) (ert-fail "Unexpected eager prewarm"))))
             (with-temp-buffer
               (magit-status-mode)
               (setq-local magit-section-cache-visibility nil)
               ,@body)))))))

(defmacro dst-lazy-test--deliver ()
  "Deliver the fixture's render and metadata stages separately."
  `(let ((render (car requests))
         (count (length requests)))
     (should-not (eq (caar render) 'validate))
     (should-not magit-difftastic-syntax-highlight)
     (cl-letf (((symbol-function 'process-file)
                (lambda (&rest _) (ert-fail "Synchronous process in callback"))))
       (funcall (nth 5 render) raw nil)
       (should (= (length requests) (1+ count)))
       (let ((validation (car requests)))
         (should (equal (car validation) (list 'validate (car render))))
         (should (equal (nth 2 validation)
                        (append (magit-difftastic--raw-args
                                 magit-difftastic--diff-base)
                                '("--" "sample.txt"))))
         (should (eq (nth 4 validation) (current-buffer)))
         (should (cl-every
                  (lambda (request)
                    (eq (magit-difftastic--lazy-file-state request) 'pending))
                  magit-difftastic--lazy-requests))
         (should (zerop (hash-table-count magit-difftastic--cache)))
         (funcall (nth 5 validation) metadata nil)
         (should (= (length requests) (1+ count)))))))

(defun dst-lazy-test--tree (&optional position parent-hidden)
  "Insert a real tree with the file at POSITION among three siblings.
Return the file request; nil POSITION inserts only the file.
Non-nil PARENT-HIDDEN initially collapses the file's parent."
  (let ((inhibit-read-only t))
    (magit-insert-section (root)
      (magit-insert-heading "Root")
      (magit-insert-section (unstaged nil parent-hidden)
        (magit-insert-heading "Unstaged")
        (dotimes (i (if position 3 1))
          (if (or (null position) (= i position))
              (magit-difftastic--insert-file-sections
               '("sample.txt") (magit-difftastic--context-unstaged))
            (magit-insert-section (neighbor i)
              (magit-insert-heading (format "Neighbor %d" i))
              (insert (format "untouched body %d\n" i))))))))
  (let (request)
    (maphash (lambda (_section value) (setq request value))
             magit-difftastic--lazy-sections)
    (should request)
    request))

(defun dst-lazy-test--body (section)
  "Return SECTION's body without text properties."
  (buffer-substring-no-properties (oref section content) (oref section end)))

(defun dst-lazy-test--check-tree (section)
  "Assert marker bounds and parent relationships throughout SECTION."
  (dolist (slot '(start content end))
    (let ((marker (slot-value section slot)))
      (should (markerp marker))
      (should (eq (marker-buffer marker) (current-buffer)))))
  (should (<= (point-min) (oref section start) (oref section content)
              (oref section end) (point-max)))
  (let ((previous (oref section content)))
    (dolist (child (oref section children))
      (should (eq (oref child parent) section))
      (should (<= previous (oref child start) (oref child end)
                  (oref section end)))
      (setq previous (oref child end))
      (dst-lazy-test--check-tree child))))

(ert-deftest magit-difftastic-lazy/collapsed-queues-heading-only ()
  (dst-lazy-test--fixture
    (let* ((request (dst-lazy-test--tree))
           (section (magit-difftastic--lazy-file-section request)))
      (should (= (length requests) 1))
      (should-not (nth 6 (car requests)))
      (should (eq (nth 4 (car requests)) (current-buffer)))
      (should (equal (nth 2 (car requests))
                     (append magit-difftastic--diff-base '("--" "sample.txt"))))
      (should (oref section hidden))
      (should (functionp (oref section washer)))
      (should (equal (dst-lazy-test--body section) ""))
      (should-not (oref section children))
      (should-not promotions)
      (should (zerop (hash-table-count magit-difftastic--syntax-cache)))
      (dst-lazy-test--check-tree magit-root-section))))

(ert-deftest magit-difftastic-lazy/first-expansion-promotes-same-job ()
  (dst-lazy-test--fixture
    (let* ((request (dst-lazy-test--tree))
           (section (magit-difftastic--lazy-file-section request))
           (job (list 'existing-job)))
      (setf (magit-difftastic--lazy-file-job request) job)
      (magit-section-show section)
      (should-not (oref section hidden))
      (should-not (oref section washer))
      (should (string-match-p "Rendering difftastic" (dst-lazy-test--body section)))
      (should (get-text-property (oref section content) 'magit-difftastic-pending))
      (should-not (invisible-p (oref section content)))
      (should (eq (car promotions) job))
      (should (equal promotions (list job job)))
      (magit-section-hide section)
      (magit-section-show section)
      (should (= (length requests) 1))
      (should (equal promotions (list job job job))))))

(ert-deftest magit-difftastic-lazy/collapsed-completion-caches-without-insertion ()
  (dst-lazy-test--fixture
    (let* ((request (dst-lazy-test--tree))
           (section (magit-difftastic--lazy-file-section request))
           (before (buffer-string)))
      (dst-lazy-test--deliver)
      (should (eq (magit-difftastic--lazy-file-state request) 'ready))
      (should (equal (buffer-string) before))
      (should (equal (gethash (magit-difftastic--lazy-file-key request)
                             magit-difftastic--cache)
                     (magit-difftastic--lazy-file-output request)))
      (should-not (oref section children))
      (should (zerop (hash-table-count magit-difftastic--syntax-cache)))
      (magit-section-show section)
      (should (eq (magit-difftastic--lazy-file-state request) 'rendered))
      (should (oref section children))
      (should (string-match-p "BRAVO-changed" (dst-lazy-test--body section)))
      (should (= (length requests) 2))
      (should (= (cl-count 'validate requests :key #'caar) 1)))))

(ert-deftest magit-difftastic-lazy/ready-after-collapse-populates-through-show-advice ()
  (dst-lazy-test--fixture
    (let* ((request (dst-lazy-test--tree))
           (section (magit-difftastic--lazy-file-section request)))
      (magit-section-show section)
      (magit-section-hide section)
      (dst-lazy-test--deliver)
      (should (eq (magit-difftastic--lazy-file-state request) 'ready))
      (should (string-match-p "Rendering difftastic" (dst-lazy-test--body section)))
      (magit-section-show section)
      (should (eq (magit-difftastic--lazy-file-state request) 'rendered))
      (let ((text (buffer-string)) (children (copy-sequence (oref section children))))
        (should children)
        (dotimes (_ 3)
          (magit-section-hide section)
          (magit-section-show section)
          (should (equal (buffer-string) text))
          (should (equal (oref section children) children))))
      (should (= (length requests) 2))
      (should (= (cl-count 'validate requests :key #'caar) 1))
      (should-not (text-property-any (oref section content) (oref section end)
                                     'magit-difftastic-pending t))
      (dst-lazy-test--check-tree magit-root-section))))

(ert-deftest magit-difftastic-lazy/replacement-preserves-neighbors-markers-and-point ()
  (dotimes (position 3)
    (dst-lazy-test--fixture
      (let* ((request (dst-lazy-test--tree position))
             (section (magit-difftastic--lazy-file-section request))
             (neighbors (cl-remove section (oref (oref section parent) children)))
             (texts (mapcar (lambda (s)
                              (buffer-substring-no-properties (oref s start) (oref s end)))
                            neighbors)))
        (magit-section-show section)
        (goto-char (oref (car (last neighbors)) content))
        (let ((saved (point-marker))
              (ends (mapcar (lambda (s) (marker-insertion-type (oref s end)))
                            (magit-section-lineage section t))))
          (unwind-protect
              (progn
                (set-buffer-modified-p nil)
                (dst-lazy-test--deliver)
                (should (= (point) saved))
                (should-not (buffer-modified-p))
                (should (equal ends
                               (mapcar (lambda (s) (marker-insertion-type (oref s end)))
                                       (magit-section-lineage section t)))))
            (set-marker saved nil)))
        (should (eq (magit-difftastic--lazy-file-state request) 'rendered))
        (should (equal texts
                       (mapcar (lambda (s)
                                 (buffer-substring-no-properties (oref s start) (oref s end)))
                               neighbors)))
        (should (= (oref magit-root-section start) (point-min)))
        (should (= (oref magit-root-section end) (point-max)))
        (dst-lazy-test--check-tree magit-root-section)))))

(ert-deftest magit-difftastic-lazy/stale-root-completion-is-ignored ()
  (dst-lazy-test--fixture
    (let* ((old (dst-lazy-test--tree))
           (callback (nth 5 (car requests))))
      (let ((inhibit-read-only t)) (erase-buffer))
      (let* ((new (dst-lazy-test--tree)) (text (buffer-string)))
        (should-not (eq (magit-difftastic--lazy-file-root old)
                        (magit-difftastic--lazy-file-root new)))
        (funcall callback raw nil)
        (should (equal text (buffer-string)))
        (should (eq (magit-difftastic--lazy-file-state old) 'pending))
        (should (eq (magit-difftastic--lazy-file-state new) 'pending))
        (should (zerop (hash-table-count magit-difftastic--cache)))))))

