            (magit-difftastic--async-cancel-buffer (current-buffer))))))))

(ert-deftest magit-difftastic-lazy/published-chunk-stages-across-displays ()
  (dolist (display dst-test--displays)
    (ert-info ((format "Lazy staging in %s" display))
      (dst-lazy-test--fixture
        (let ((magit-difftastic-display display)
              (magit-difftastic-line-numbers
               (not (equal display "side-by-side-show-both"))))
          (setq raw (funcall dst-lazy-test--render-raw
                             "sample.txt" magit-difftastic--diff-base 120))
          (let* ((expected (dst-test--git "diff" "--" "sample.txt"))
                 (request (dst-lazy-test--tree))
                 (section (magit-difftastic--lazy-file-section request)))
            (should-not (string-empty-p expected))
            (should (string-empty-p (dst-test--git "diff" "--cached")))
            (magit-section-show section)
            (should (eq (magit-difftastic--lazy-file-state request) 'pending))
            (should-not (oref section children))
            (dst-lazy-test--deliver)
            (should (eq (magit-difftastic--lazy-file-state request) 'rendered))
            (should (= (length (oref section children)) 1))
            (let ((chunk (car (oref section children)))
                  (refreshes 0))
              (should (eq (oref chunk type) 'magit-difftastic-hunk))
              (should (eq (oref chunk parent) section))
              (goto-char (oref chunk content))
              (unless magit-difftastic-line-numbers
                (let ((gutter (get-text-property (point) 'display)))
                  (should (stringp gutter))
                  (should (string-blank-p gutter))
                  (should (looking-at-p "[0-9]"))))
              (cl-letf (((symbol-function 'magit-refresh)
                         (lambda (&rest _) (cl-incf refreshes))))
                (magit-difftastic--stage-chunk-1 chunk))
              (should (= refreshes 1)))
            (should (equal (dst-test--git "diff" "--cached" "--" "sample.txt")
                           expected))
            (should (equal (dst-test--git "show" ":sample.txt") dst-test--new))
            (should (string-empty-p (dst-test--git "diff")))
            (dst-lazy-test--check-tree magit-root-section)))))))

(ert-deftest magit-difftastic-lazy/publication-hides-chunk-bodies ()
  (dst-lazy-test--fixture
